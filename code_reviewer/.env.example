# Explicit provider selection: groq, ollama, or claude
LLM_PROVIDER=groq

# Groq settings (required only when LLM_PROVIDER=groq)
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama settings (required only when LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Claude settings (required only when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=8192

# Local metadata only; raw source and credentials are not stored
REVIEW_HISTORY_DB=.review_history.sqlite3

# Test execution is disabled by default. On Windows, an external isolated runner
# must be configured before enabling it.
ENABLE_TEST_RUNNER=false
TEST_RUNNER_ISOLATED=false

# GitHub read-only PR adapter (optional)
GITHUB_TOKEN=your_github_token_here

# API authentication (optional, for code/api.py)
API_AUTH_SECRET=your_api_secret_here

# Size and time limits
MAX_UPLOAD_BYTES=524288
MAX_ARCHIVE_BYTES=10485760
MAX_FILES=200
MAX_TOTAL_UNCOMPRESSED=20971520
MAX_API_SOURCE_BYTES=524288
TOOL_TIMEOUT_SECONDS=10
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_OUTPUT_BYTES=65536
